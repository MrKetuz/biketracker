@using BiketrackerFrontend.DataStruts
<div class="route-overview">

    <h3>Route Overview</h3>

    <div class="route-subtitle">
        A → B
    </div>

    <div class="stats-grid">

        <div class="stat">
            <div class="label">Distance</div>
            <div class="value">@SegmentOfRoute.Distance km</div>
        </div>

        <div class="stat">
            <div class="label">Time</div>
            <div class="value">@SegmentOfRoute.Duration.ToString(@"hh\:mm\:ss"); </div>
        </div>

        <div class="stat">
            <div class="label">Avg Speed</div>
            <div class="value">@SegmentOfRoute.Speed km/h</div>
        </div>

    </div>
    <button @onclick="onreset">
        Back to Overview
    </button>
</div>

@code {
    [Parameter]
    public SegmentStats SegmentOfRoute { get; set; }

    [Parameter]
    public EventCallback onreset { get; set; }
}

