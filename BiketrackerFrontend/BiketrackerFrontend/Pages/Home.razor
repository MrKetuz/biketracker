    //Calculates distance between two points, returns value as meters.
    private double calcDistanceBetweenPoints(double lat1, double lng1, double lat2, double lng2)
    {


        double distance = realTimeMap.Geometric.Computations.distance(lat1, lng1, lat2, lng2, RealTimeMap.UnitOfMeasure.kilometers);
        Logger.LogWarning($"Distance between points: {distance} kilometers");

        return Math.Round(distance, 1);
    }

    private double calcSpeed (double distance, DateTime timestamp1, DateTime timestamp2)
    {
        return Math.Round(distance / (timestamp2 - timestamp1).TotalHours , 1); //Speed in km/h
    }

    private void DEBUG()
    {
        DateTime timestamp = DateTime.Now;
        Logger.LogWarning($"Current timestamp: {timestamp}");
    }

    public void onClickMap(RealTimeMap.ClicksMapArgs value)
    {
        //where value.sender is RealTimeMap control reference
        Logger.LogWarning($"{value.location.latitude}");
        Logger.LogWarning($"{value.location.longitude}");

        //Get first point
        if(State == InfoboxState.Overview)
        {
            index1 = findClosestRoutePointIndex(data, value.location.latitude, value.location.longitude);
            if (index1 == -1)
                return;
            State = InfoboxState.StartSelected;
            return;
        }
        if(State == InfoboxState.StartSelected)
        {
            index2 = findClosestRoutePointIndex(data, value.location.latitude, value.location.longitude);
            if(index1 == index2 || index2 == -1)
                return;


            buildSegment();

            State = InfoboxState.SegmentSelected;
        }
    }


    int findClosestRoutePointIndex(List<GpsPoint> route, double clickLat, double clickLng)
    {
        double minDistance = double.MaxValue;
        int closestIndex = 0;

        for (int i = 0; i < route.Count; i++)
        {
            double d = calcDistanceBetweenPoints(
                clickLat, clickLng,
                route[i].Lat, route[i].Lng);

            if (d < minDistance)
            {
                minDistance = d;
                closestIndex = i;
            }
        }

        if (minDistance > .05)
        {
            return -1;
        }
        return closestIndex;
    }

    private void buildSegment()
    {
        segment.Clear();


        int start = Math.Min(index1.Value, index2.Value);
        int end = Math.Max(index1.Value, index2.Value);

        for (int i = start; i <= end; i++)
        {
            segment.Add(data[i]);
        }



        SegmentOfRoute = CalculateStats(segment);
    }

    private SegmentStats CalculateStats(List<GpsPoint> segment)
    {
        double totalDistance = 0;
        TimeSpan totalTime = TimeSpan.Zero;
        for (int i = 0; i < segment.Count - 1; i++)
        {
            totalDistance += calcDistanceBetweenPoints(
                segment[i].Lat, segment[i].Lng,
                segment[i + 1].Lat, segment[i + 1].Lng);
            totalTime += segment[i + 1].Timestamp - segment[i].Timestamp;
        }
        double averageSpeed = Math.Round(totalTime.TotalHours > 0 ? totalDistance / totalTime.TotalHours : 0, 1);
        return new SegmentStats
        {
            Distance = totalDistance,
            Duration = totalTime,
            Speed = averageSpeed
        };
    }

    private void ResetToOverview()
    {
        index1 = null;
        index2 = null;
        segment.Clear();
        State = InfoboxState.Overview;

        StateHasChanged();
    }
