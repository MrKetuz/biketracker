@page "/"
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject HttpClient Http
@using BiketrackerFrontend.DataStruts
@using Microsoft.Extensions.Logging



<PageTitle>Bike Tracker</PageTitle>

<h1>Bike Tracker</h1>

<div class="map-layout">


<div class="map">
      <RealTimeMap 
      @ref="realTimeMap"
      Parameters="parameters" 
      height="calc(80vh)" 
      width="100%"
      OnClickMap="onClickMap"></RealTimeMap>


</div>
<div class="infobox">   
        @switch (State)
    {
        case InfoboxState.Overview:
            <RouteOverview Route="Route" />
            break;

        case InfoboxState.StartSelected:
            <StartSelectedView  onreset="ResetToOverview"/>
            break;

        case InfoboxState.SegmentSelected:
            <SegmentView  SegmentOfRoute="SegmentOfRoute" onreset="ResetToOverview"/>
            break;
    }


        @if (Routes.Any())
        {
            <div class="route-box">
                <select @bind="selectedRouteId">
                    <option value="">-- Select Route --</option>

                    @foreach (var route in Routes)
                    {
                        <option value="@route.Id">
                            @route.Name
                        </option>
                    }
                </select>
                <br />
                <button class="btn-primary" @onclick="loadRoute">
                    Load Route
                </button>
            </div>

        }

</div>
</div>

<div class="input-field"
    <InputText @bind-Value="Username" class="form-control" placeholder="Username"></InputText>
    <button @onclick="getRoutesFromUsername" class="btn-primary">Get Routes</button> <br />
    @if (getUser)
    {
        @if (response.IsSuccessStatusCode)
        {
            <span class="alert-success">Successfully acquired the routes!</span>
        }
        else
        {
            <span class="alert-danger">Failed trying to get routes from user: Error: @response.StatusCode.ToString()</span>
        }
    }

    @if (errorMessage != string.Empty)
    {
        <span class="alert-danger">@errorMessage.ToString()</span>
    }

</div>





<br /><br />



@code {
    RealTimeMap? realTimeMap;
    private string Username = string.Empty;
    private RealTimeMap.LoadParameters parameters = new RealTimeMap.LoadParameters()  //general map settings
         {
             zoomLevel = 8
         };


    enum InfoboxState
    {
        Overview,
        StartSelected,
        SegmentSelected
    }
    InfoboxState State = InfoboxState.Overview;


    List<RoutePointResponse> segment = new List<RoutePointResponse>();
    SegmentStats Route = new SegmentStats();
    SegmentStats SegmentOfRoute = new SegmentStats();
    private List<RoutePointResponse> currentData = new List<RoutePointResponse>();
    private RouteResponse? routeResponse;
    private List<RouteResponse> Routes = new List<RouteResponse>();
    private long? selectedRouteId;
    private List<RealTimeMap.MeasureLine> lines = new List<RealTimeMap.MeasureLine>();
    private HttpResponseMessage response = new HttpResponseMessage();
    private bool getUser = false;
    private string errorMessage = string.Empty;


    //Adds points to the map from a list of GpsPoint objects and sets the map view to center on the first point in the line.
    private void AddPointsTest(List<RoutePointResponse> data)
    {

        realTimeMap.View.setCenter = new RealTimeMap.Location()
        {
            latitude = data[1].Latitude,
            longitude = data[1].Longitude,
        };
        realTimeMap.View.setZoomLevel = 16;

        addLines(data);

        currentData = data;
    }

    //Adds lines between points in the data list and calculates the route stats.
    private void addLines(List<RoutePointResponse> data)
    {
        int i = 0;
        foreach (var point in data)
        {
            if (i != data.Count - 1)
            {
                double lat1 = data[i].Latitude, lat2 = data[i + 1].Latitude, lng1 = data[i].Longitude, lng2 = data[i + 1].Longitude;

                DateTime timestamp1 = data[i].RecordedAt, timestamp2 = data[i + 1].RecordedAt;

                double distance = calcDistanceBetweenPoints(lat1, lng1, lat2, lng2);

                double speed = calcSpeed(distance, timestamp1, timestamp2);

                RealTimeMap.MeasureLine line = new RealTimeMap.MeasureLine
                    {
                        start = new[] { lat1, lng1 },
                        end = new[] { lat2, lng2 },

                    };
                lines.Add(line);
                realTimeMap.Geometric.DisplayPolylinesFromArray.addMeasure(line);
                i++;
            }

        }

        Route = CalculateStats(data);
    }

    //Calculates distance between two points, returns value as kilometers.
    private double calcDistanceBetweenPoints(double lat1, double lng1, double lat2, double lng2)
    {


        double distance = realTimeMap.Geometric.Computations.distance(lat1, lng1, lat2, lng2, RealTimeMap.UnitOfMeasure.kilometers);
        Logger.LogDebug($"Distance between points: {distance} kilometers");

        return distance;
    }

    //Calculates speed between two points, returns value as kilometers per hour.
    private double calcSpeed (double distance, DateTime timestamp1, DateTime timestamp2)
    {
        return distance / (timestamp2 - timestamp1).TotalHours;
    }


    //Event handler for map click events
    public void onClickMap(RealTimeMap.ClicksMapArgs value)
    {
        int i1 = 0, i2 = 0;


        //where value.sender is RealTimeMap control reference
        Logger.LogWarning($"{value.location.latitude}");
        Logger.LogWarning($"{value.location.longitude}");

        //Get first point, return if no point is close enough, otherwise change state to StartSelected
        if(State == InfoboxState.Overview)
        {
            i1 = findClosestRoutePointIndex(currentData, value.location.latitude, value.location.longitude);
            if (i1 == -1)
                return;
            State = InfoboxState.StartSelected;
            return;
        }
        //Get second point, return if no point is close enough or if it is the same as the first point, otherwise build segment and change state to SegmentSelected
        if(State == InfoboxState.StartSelected)
        {
            i2 = findClosestRoutePointIndex(currentData, value.location.latitude, value.location.longitude);
            if(i1 == i2 || i2 == -1)
                return;


            buildSegment(i1, i2);

            State = InfoboxState.SegmentSelected;
        }
    }

    //Gets closest point index in route to clicked point, returns -1 if no point is close enough.
    int findClosestRoutePointIndex(List<RoutePointResponse> route, double clickLat, double clickLng)
    {
        double requiredDistance = 0.05; // 50 meters
        double minDistance = double.MaxValue;
        int closestIndex = 0;

        for (int i = 0; i < route.Count; i++)
        {
            double d = calcDistanceBetweenPoints(
                clickLat, clickLng,
                route[i].Latitude, route[i].Longitude);

            if (d < minDistance)
            {
                minDistance = d;
                closestIndex = i;
            }
        }

        if (minDistance > requiredDistance)
        {
            return -1;
        }
        return closestIndex;
    }

    //Builds a segment of the route between two indices and calculates its stats.
    private void buildSegment(int i1, int i2)
    {
        segment.Clear();


        int start = Math.Min(i1, i2);
        int end = Math.Max(i1, i2);

        for (int i = start; i <= end; i++)
        {
            segment.Add(currentData[i]);
        }



        SegmentOfRoute = CalculateStats(segment);
    }

    //Calculates distance, duration, and average speed for a segment of the route.
    private SegmentStats CalculateStats(List<RoutePointResponse> segment)
    {
        double totalDistance = 0;
        TimeSpan totalTime = TimeSpan.Zero;
        for (int i = 0; i < segment.Count - 1; i++)
        {
            totalDistance += calcDistanceBetweenPoints(
                segment[i].Latitude, segment[i].Longitude,
                segment[i + 1].Latitude, segment[i + 1].Longitude);
            totalTime += segment[i + 1].RecordedAt - segment[i].RecordedAt;
        }
        double averageSpeed = totalTime.TotalHours > 0 ? totalDistance / totalTime.TotalHours : 0;
        return new SegmentStats
        {
            Distance = totalDistance,
            Duration = totalTime,
            Speed = averageSpeed
        };
    }

    //Resets the state to Overview and clears the selected segment.
    private void ResetToOverview()
    {
        segment.Clear();
        State = InfoboxState.Overview;

        StateHasChanged();
    }

    //Gets routes from username
    private async Task getRoutesFromUsername()
    {
        try
        {

            response = await Http.GetAsync($"api/bikedata/user/{Username}");
            getUser = true;

            if (response.IsSuccessStatusCode)
            {
                Routes = await response.Content.ReadFromJsonAsync<List<RouteResponse>>();
            }

        }
        catch(Exception ex)
        {
            Logger.LogError($"Error fetching routes for username {Username}: {ex.Message}");

            errorMessage = $"Error fetching routes";
        }
    }
    private async Task loadRoute()
    {
        if (selectedRouteId == null)
            return;

        routeResponse = await Http.GetFromJsonAsync<RouteResponse>
        ($"api/bikedata/routes/{selectedRouteId}");

        await realTimeMap.Geometric.DisplayPolylinesFromArray.deleteMeasure();

        await realTimeMap.Geometric.DataFromGeoJSON.clearMap();

        AddPointsTest(routeResponse.Points);
    }

}