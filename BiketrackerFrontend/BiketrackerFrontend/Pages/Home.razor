@page "/"
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject HttpClient Http
@using BiketrackerFrontend.DataStruts
@using Microsoft.Extensions.Logging
@using System.Text.Json



<PageTitle>Home</PageTitle>

<div class="map-layout">


<div class="map">
      <RealTimeMap 
      @ref="realTimeMap"
      Parameters="parameters" 
      height="calc(80vh)" 
      width="100%"
      OnClickMap="onClickMap"></RealTimeMap>
</div>
<div class="infobox">   
        @switch (State)
    {
        case InfoboxState.Overview:
            <RouteOverview Route="Route" />
            break;

        case InfoboxState.StartSelected:
            <StartSelectedView  onreset="ResetToOverview"/>
            break;

        case InfoboxState.SegmentSelected:
            <SegmentView  SegmentOfRoute="SegmentOfRoute" onreset="ResetToOverview"/>
            break;
    }

</div>
</div>



<InputText @bind-Value="Username" class="form-control"></InputText>
<button @onclick="getRoutesFromUsername" class="btn-primary">Get Routes</button>

<br /><br />

@if (Routes.Any())
{
    <select @bind="selectedRouteId">
        <option value="">-- Select Route --</option>

        @foreach (var route in Routes)
        {
            <option value="@route.Id">
                @route.Name
            </option>
        }
    </select>

    <button @onclick="loadRoute">
        Load Route
    </button>
}

