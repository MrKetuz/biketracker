            break;

        case InfoboxState.StartSelected:
            <StartSelectedView  onreset="ResetToOverview"/>
            break;

        case InfoboxState.SegmentSelected:
            <SegmentView  SegmentOfRoute="SegmentOfRoute" onreset="ResetToOverview"/>
            break;
    }

</div>
</div>



