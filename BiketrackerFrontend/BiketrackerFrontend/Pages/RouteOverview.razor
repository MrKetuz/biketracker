@using BiketrackerFrontend.DataStruts
<div class="route-overview">

    <h3>Route Overview</h3>

    <div class="route-subtitle">
        A → B
    </div>

    <div class="stats-grid">

        <div class="stat">
            <div class="label">Distance</div>
            <div class="value">@Route.Distance.ToString("0.000") km</div>
        </div>

        <div class="stat">
            <div class="label">Time</div>
            <div class="value">@Route.Duration.ToString(@"hh\:mm\:ss"); </div>
        </div>

        <div class="stat">
            <div class="label">Avg Speed</div>
            <div class="value">@Route.Speed.ToString("0.0") km/h</div>
        </div>

    </div>

    <div class="hint">
        Click the map to select a segment
    </div>

</div>

@code {
    [Parameter]
    public SegmentStats Route { get; set; }
}
