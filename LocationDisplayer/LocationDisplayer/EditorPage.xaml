<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LocationDisplayer.ExportPage"
    Title="Export Data">

    <VerticalStackLayout Padding="15" Spacing="10">

        <Label
            Text="Copy the contents below"
            FontSize="18"
            FontAttributes="Bold" />

        <Editor
            x:Name="ExportEditor"
            IsReadOnly="False"
            AutoSize="Disabled"
            HeightRequest="500"
            VerticalOptions="FillAndExpand"
            HorizontalOptions="Fill"
            FontFamily="Consolas" />

        <Button
            Text="Copy"
            Clicked="Copy_Clicked" />
        
        <Button
            Text="Close"
            Clicked="Close_Clicked" />

    </VerticalStackLayout>

</ContentPage>